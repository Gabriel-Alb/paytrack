PORT=3000
NODE_ENV=development
HOST=127.0.0.1
# Desenvolvimento local. Produção recusa SQLite, inclusive :memory:.
DATABASE_CLIENT=sqlite
DATABASE_PATH=./database/paytrack.db
# PostgreSQL: obrigatório em produção. Injetar variáveis no processo de produção;
# .env é carregado automaticamente apenas no desenvolvimento.
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://paytrack:senha@host:5432/paytrack
DATABASE_SSL=verify-full
# DATABASE_SSL_CA=./certificates/postgres-ca.pem
# Para PostgreSQL local sem TLS, definir explicitamente DATABASE_SSL=disable.
# Não usar parâmetros sslmode/sslcert/sslkey/sslrootcert na DATABASE_URL.
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=30000
# Validação real: banco exclusivo de testes, com permissão CREATE SCHEMA.
# TEST_DATABASE_URL=postgresql://paytrack_test:senha@localhost:5432/paytrack_test
FRONTEND_ORIGIN=http://localhost:5173
TIME_ZONE=America/Sao_Paulo
ATTENTION_DAYS=2

# Segundos: 24h absolutas, 2h de inatividade (sem sessão infinita).
SESSION_MAX_AGE=86400
SESSION_IDLE_AGE=7200
AUTH_WINDOW_MS=900000
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_REQUEST_IP_LIMIT=5

# Produção: NODE_ENV=production e FRONTEND_ORIGIN=https://seu-dominio
# Defina apenas quando o proxy TLS estiver no loopback e a API não estiver exposta.
# TRUST_PROXY=loopback
# Não há SESSION_SECRET: cookies opacos aleatórios são verificados por hash no banco.
# Documentos não têm criptografia por campo nesta etapa; proteja volume e backups.

# Desenvolvimento LAN: FRONTEND_ORIGIN define protocolo/porta do frontend.
# Localhost e IPv4 privados desta máquina são aceitos só em NODE_ENV=development.
# Use VITE_API_URL vazio e o proxy Vite; HOST pode continuar em 127.0.0.1.
