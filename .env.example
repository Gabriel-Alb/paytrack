# Compose only: backend and frontend also have their own development examples.
# Generate independent secrets; never commit the real .env.
POSTGRES_DB=paytrack
POSTGRES_USER=paytrack
POSTGRES_PASSWORD=
# Use the same database/password above; percent-encode special URL characters.
DATABASE_URL=
# Internal Compose PostgreSQL has no TLS. Remote databases require verify-full.
DATABASE_SSL=disable
DATABASE_POOL_MAX=5
FRONTEND_ORIGIN=https://localhost
COOKIE_SAME_SITE=strict
VITE_API_URL=/api
IMAGE_TAG=local
BACKEND_IMAGE=paytrack-backend
FRONTEND_IMAGE=paytrack-frontend
HTTP_PORT=8080
TLS_PROXY_CIDR=172.31.0.1/32
# Optional compose.tls.yaml: localhost uses a local CA; real DNS uses automatic TLS.
SITE_ADDRESS=localhost
TLS_BIND_IP=127.0.0.1
HTTPS_PORT=443
HTTPS_REDIRECT_PORT=80
